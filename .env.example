# Copy to /opt/wardrobe-lab/shared/.env; never commit the real file.
LAB_PASSWORD=replace-with-a-long-private-password
LAB_SESSION_SECRET=replace-with-at-least-32-random-characters
LAB_DEV_MODE=false
LAB_LIVE_ENABLED=false
LAB_PUBLIC_BASE_URL=https://lab.example.com
LAB_DAILY_BUDGET_CNY=30
LAB_DAILY_CALL_LIMIT=20
LAB_POLL_SECONDS=15
LAB_ASSET_TTL_SECONDS=21600
CADDY_SITE=lab.example.com
LAB_DATA_PATH=/opt/wardrobe-lab/shared/data
LAB_ENV_FILE=/opt/wardrobe-lab/shared/.env
LAB_APP_IMAGE=wardrobe-lab:local
ARK_API_KEY=
ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
DASHSCOPE_API_KEY=
# Optional Beijing workspace host: https://YOUR_WORKSPACE.cn-beijing.maas.aliyuncs.com
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com
TOKENHUB_API_KEY=
VIDU_API_KEY=
MINIMAX_API_KEY=
KLING_API_KEY=
